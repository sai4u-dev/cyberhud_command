NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://localhost:27017/cyberhud_command
# Or MongoDB Atlas: mongodb+srv://<user>:<pass>@cluster.mongodb.net/cyberhud

JWT_ACCESS_SECRET=change_this_super_secret_access_key_32chars_min
JWT_REFRESH_SECRET=change_this_super_secret_refresh_key_32chars_min
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

FRONTEND_URL=http://localhost:5173
# Comma-separated extra allowed origins (staging, preview deploys)
ADDITIONAL_ORIGINS=
COOKIE_DOMAIN=

# Optional — caching / realtime scale-out. Unset = in-memory fallback (single instance).
REDIS_URL=
# Optional — error tracking
SENTRY_DSN=

# Tuning
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
BODY_LIMIT=10kb
LOG_LEVEL=info
MONGO_MAX_POOL=10

GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_MAPS_API_KEY=your_google_maps_key
