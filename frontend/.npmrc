# The 3D/map ecosystem (@react-three/fiber, drei, react-leaflet) publishes
# peer ranges that lag behind React releases (e.g. fiber caps react <19.3
# while 19.3.x is current). Strict peer resolution can therefore never be
# satisfied upstream, so reproducible installs require legacy mode.
# Applies to local dev, CI (`npm ci`) and the Docker build uniformly.
legacy-peer-deps=true
